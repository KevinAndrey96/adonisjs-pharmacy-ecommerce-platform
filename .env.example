HOST=127.0.0.1
PORT=3333
NODE_ENV=development
APP_NAME="Pharmacy E-Commerce Platform"
APP_URL=http://${HOST}:${PORT}

CACHE_VIEWS=false

# 32-character application encryption key, generate one with: openssl rand -hex 16
APP_KEY=

# Database Configuration (sqlite for zero-config local development, mysql for production/docker)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=development

# Session & Security
SESSION_DRIVER=cookie
HASH_DRIVER=bcrypt

# Mailer Configuration (Defaults to Mailpit in Docker)
MAIL_CONNECTION=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Optional Payment Gateway Integration (Credibanco)
ENABLE_PAYMENT_GATEWAY=false
GATEWAY_USERNAME=
GATEWAY_PASSWORD=
GATEWAY_URL=https://ecouat.credibanco.com/payment/rest/register.do
