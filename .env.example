HOST=127.0.0.1
PORT=3333
NODE_ENV=development
APP_NAME=PharmaStore
APP_URL=http://${HOST}:${PORT}
CACHE_VIEWS=false
APP_KEY=32_character_random_secret_key_here

# Database Configuration
# Options: mysql | sqlite | pg
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pharmastore_user
DB_PASSWORD=pharmastore_pass
DB_DATABASE=pharmastore_db

# Session & Hashing
SESSION_DRIVER=cookie
HASH_DRIVER=bcrypt

# Mailer Configuration (Default: Mailpit / MailHog local testing)
MAIL_CONNECTION=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pharmastore.local

# Payment Gateway (Credibanco Sandbox / Gateway Simulator)
PAYMENT_GATEWAY_URL=https://ecouat.credibanco.com/payment/rest/register.do
PAYMENT_GATEWAY_USER=sandbox_user
PAYMENT_GATEWAY_PASSWORD=sandbox_pass
