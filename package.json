{
  "name": "adonisjs-pharmacy-ecommerce-platform",
  "version": "1.0.0",
  "description": "Tienda en línea de droguería con catálogo de salud y cuidado personal, cupones, boletín y backoffice de inventario y pedidos, construida con AdonisJS 4 y MySQL.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "adonis serve --dev",
    "migrate": "node ace migration:run",
    "seed": "node ace seed",
    "lint": "eslint .",
    "test": "node test/smoke.js"
  },
  "keywords": [
    "pharmacy",
    "ecommerce",
    "drugstore",
    "inventory-management",
    "nodejs",
    "adonisjs",
    "javascript",
    "fullstack"
  ],
  "author": "Kevin Andrey Herrera Silva <kahs_kevin@hotmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@adonisjs/ace": "^5.0.8",
    "@adonisjs/auth": "^3.0.7",
    "@adonisjs/bodyparser": "^2.0.5",
    "@adonisjs/cors": "^1.0.7",
    "@adonisjs/fold": "^4.0.9",
    "@adonisjs/framework": "^5.0.9",
    "@adonisjs/ignitor": "^2.0.8",
    "@adonisjs/lucid": "^21.8.2",
    "@adonisjs/mail": "^3.0.10",
    "@adonisjs/session": "^1.0.27",
    "@adonisjs/shield": "^1.0.8",
    "axios": "^0.19.2",
    "form-data": "^3.0.0",
    "mysql": "^2.18.1",
    "sqlite3": "^6.0.1"
  },
  "autoload": {
    "App": "./app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
