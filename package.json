{
  "name": "pharmacy-ecommerce-platform",
  "version": "1.0.0",
  "description": "Open-source full-stack pharmacy & drugstore e-commerce platform with inventory management backoffice built with Node.js and AdonisJS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node ace migration:run",
    "seed": "node ace seed",
    "test": "node ace migration:status",
    "syntax-check": "node -c server.js ace app/**/*.js start/*.js config/*.js database/**/*.js"
  },
  "keywords": [
    "pharmacy",
    "ecommerce",
    "drugstore",
    "inventory-management",
    "nodejs",
    "adonisjs",
    "javascript",
    "fullstack",
    "open-source"
  ],
  "author": "Kevin Andrey Herrera Silva <kahs_kevin@hotmail.com>",
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@adonisjs/ace": "^5.0.8",
    "@adonisjs/auth": "^3.0.7",
    "@adonisjs/bodyparser": "^2.0.5",
    "@adonisjs/cors": "^1.0.7",
    "@adonisjs/fold": "^4.0.9",
    "@adonisjs/framework": "^5.0.9",
    "@adonisjs/ignitor": "^2.0.8",
    "@adonisjs/lucid": "^6.1.3",
    "@adonisjs/mail": "^3.0.10",
    "@adonisjs/session": "^1.0.27",
    "@adonisjs/shield": "^1.0.8",
    "axios": "^0.19.2",
    "form-data": "^3.0.0",
    "mysql": "^2.18.1",
    "objection": "^2.2.2",
    "sqlite3": "^6.0.1"
  },
  "autoload": {
    "App": "./app"
  }
}
